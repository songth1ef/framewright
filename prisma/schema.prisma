generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

// 后端领域模型见 docs/backend-domain.md。
// SQLite 不支持 enum 与标量数组：role/kind/origin/status 存 String（TS 层联合类型约束），
// 数组与 params 存 Json。
// 拥有关系（Project→Document/Session/Asset、Session→Message）建外键 + 级联删除；
// 回溯引用（Generation 的各 id、Asset.generationId、Message.documentId）只建普通列 + 索引，
// 不与被引用方的生命周期耦合。

model Project {
  id           String       @id @default(cuid())
  name         String
  description  String?
  coverAssetId String?
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt
  documents    Document[]
  sessions     Session[]
  assets       Asset[]
}

model Document {
  id         String         @id @default(cuid())
  projectId  String
  name       String
  root       Json
  historySeq Int            @default(0)
  createdAt  DateTime       @default(now())
  updatedAt  DateTime       @updatedAt
  project    Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  history    HistoryEntry[]

  @@index([projectId])
}

model HistoryEntry {
  id         String   @id @default(cuid())
  documentId String
  seq        Int
  op         Json
  createdAt  DateTime @default(now())
  document   Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@unique([documentId, seq])
  @@index([documentId])
}

model Session {
  id        String    @id @default(cuid())
  projectId String
  title     String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  project   Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  messages  Message[]

  @@index([projectId])
}

model Message {
  id            String   @id @default(cuid())
  sessionId     String
  seq           Int
  role          String
  content       String
  /// 回溯锚点（正向）：这条消息发起的生成任务 id 列表
  generationIds Json
  /// 回溯锚点（正向）：这条消息在画布上产生的节点 fwId 列表
  nodeFwIds     Json
  /// 发消息时用户所在的画布，只做记录不建外键
  documentId    String?
  createdAt     DateTime @default(now())
  session       Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, seq])
}

model Asset {
  id           String   @id @default(cuid())
  projectId    String
  kind         String
  origin       String
  storageKey   String
  mimeType     String
  byteSize     Int
  width        Int?
  height       Int?
  durationMs   Int?
  /// 生成而来的素材指回它的生成任务，只做索引不建外键
  generationId String?
  createdAt    DateTime @default(now())
  project      Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@index([projectId])
  @@index([generationId])
}

model Generation {
  id             String    @id @default(cuid())
  projectId      String
  documentId     String
  /// 经对话发起时有值，直接点节点上的「生成」时为 null。回溯引用，只建索引。
  sessionId      String?
  messageId      String?
  status         String
  kind           String
  /// 生成参数原样留存，供复跑
  params         Json
  /// 输入素材（图生图/图生视频的参考图）id 列表
  inputAssetIds  Json
  /// 产出素材 id 列表
  outputAssetIds Json
  errorMessage   String?
  createdAt      DateTime  @default(now())
  finishedAt     DateTime?

  @@index([projectId])
  @@index([documentId])
  @@index([messageId])
}
