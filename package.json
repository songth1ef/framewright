{
  "name": "framewright",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "packageManager": "pnpm@11.10.0",
  "scripts": {
    "typecheck": "tsc --build --force",
    "test": "vitest run",
    "test:discovery": "node tools/check-test-discovery.mjs",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "verify": "pnpm typecheck && pnpm test:discovery && pnpm test && pnpm e2e",
    "setup": "pnpm db:generate && pnpm db:deploy && pnpm exec playwright install chromium",
    "db:generate": "node tools/prisma.mjs generate --schema prisma/schema.prisma",
    "db:deploy": "node tools/prisma.mjs migrate deploy --schema prisma/schema.prisma",
    "db:migrate": "node tools/prisma.mjs migrate dev --schema prisma/schema.prisma",
    "dev": "pnpm --filter @framewright/web dev"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@prisma/client": "6.19.3",
    "@types/node": "^22.20.1",
    "better-sqlite3": "11.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "jsdom": "^27.4.0",
    "prisma": "^6.19.3",
    "typescript": "^5.9.3",
    "vitest": "^4.1.10"
  }
}
